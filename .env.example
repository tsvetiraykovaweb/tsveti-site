# Environment variables for Цветелина Райкова site
# Copy to `.env.local` and fill in real values. Never commit secrets.

# --- Supabase (public — safe for browser) ---
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# --- Supabase (server-only — NEVER use NEXT_PUBLIC_ prefix) ---
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- Site ---
# Local: http://localhost:3000
# Production: set after first Vercel deploy (e.g. https://your-project.vercel.app)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Consultation email notify (optional; form still works without these) ---
# Get an API key at https://resend.com
RESEND_API_KEY=
# Inbox that receives new-request alerts
CONSULTATION_NOTIFY_TO=you@example.com
# Verified sender in Resend (use onboarding@resend.dev only for tests)
CONSULTATION_NOTIFY_FROM="Цветелина Райкова <onboarding@resend.dev>"

# --- Vercel cron (Production only) ---
# Random secret; Vercel sends Authorization: Bearer <CRON_SECRET> to cron routes
CRON_SECRET=
